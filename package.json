{
  "name": "vue-shepherd",
  "version": "6.0.0",
  "description": "A Vue wrapper for the site tour library Shepherd.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipshapecode/vue-shepherd.git"
  },
  "license": "AGPL-3.0",
  "author": {
    "name": "Robert Wagner",
    "email": "rwwagner90@gmail.com",
    "url": "https://github.com/RobbieTheWagner"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vue-shepherd.min.js",
  "jsdelivr": "./dist/vue-shepherd.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "vite",
    "lint": "pnpm lint:js && pnpm lint:types && pnpm lint:package",
    "lint:js": "eslint . --max-warnings 0",
    "lint:package": "pnpm build && publint --strict && attw --pack --profile node16",
    "lint:types": "tsc --noEmit",
    "prepack": "pnpm build",
    "start": "vite",
    "test": "vitest run",
    "test:e2e": "start-server-and-test 'vite --port 5174 --strictPort' http://localhost:5174 'cypress run'",
    "test:e2e:open": "start-server-and-test 'vite --port 5174 --strictPort' http://localhost:5174 'cypress open'",
    "test:watch": "vitest"
  },
  "dependencies": {
    "shepherd.js": "^16.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@types/node": "^26.6.6",
    "@vue/test-utils": "^2.6.0",
    "cypress": "^16.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "~7.0.5",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "start-server-and-test": "^3.0.13",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "release-plan": "^0.20.1"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "keywords": [
    "vue",
    "nuxt",
    "site tour",
    "tour",
    "guided tour",
    "onboarding",
    "shepherd"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">= 20"
  }
}
