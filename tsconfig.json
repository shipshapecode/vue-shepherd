{
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "vue-shepherd": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "dev", "cypress", "*.ts"]
}
